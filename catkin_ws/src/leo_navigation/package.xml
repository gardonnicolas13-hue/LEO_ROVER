<?xml version="1.0"?>
<package format="2">
  <name>leo_navigation</name>
  <version>0.1.0</version>
  <description>
    Sélection dynamique de la source de pose (VINS/MINS) pour le LEO Rover :
    pose_selector republie une pose unique et continue sur /robot_pose_fused,
    plus les transformations statiques manquantes (base_link -> camera/imu)
    nécessaires à MINS pour calculer une position globale.
  </description>
  <maintainer email="gardon.nicolas13@gmail.com">Nicolas Gardon</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- minimu9_node (2026-09-08): first C++ node in this package. -->
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>leo_msgs</build_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>leo_msgs</exec_depend>

  <export></export>
</package>
