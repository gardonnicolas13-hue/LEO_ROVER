+#include "TagPoseCorrector.h"
+
+#include <algorithm>
+#include <cmath>
+#include <sstream>
+#include <string>
+
+#include "core/VioManager.h"
+#include "core/VioManagerOptions.h"
+#include "state/State.h"
+#include "utils/print.h"
+#include "utils/quat_ops.h"
+
+using namespace ov_srvins;
+
+namespace {
+
+/// Comma-separated "0,1,2" -> {0,1,2}. Empty/whitespace entries are skipped
+/// rather than throwing: a trailing comma in the YAML should not crash the
+/// estimator over a formatting slip.
+std::set<int> parse_id_list(const std::string &csv) {
+  std::set<int> out;
+  std::stringstream ss(csv);
+  std::string tok;
+  while (std::getline(ss, tok, ',')) {
+    size_t a = tok.find_first_not_of(" \t");
+    size_t b = tok.find_last_not_of(" \t");
+    if (a == std::string::npos) continue;
+    try {
+      out.insert(std::stoi(tok.substr(a, b - a + 1)));
+    } catch (const std::exception &e) {
+      PRINT_WARNING(YELLOW "[TAG-CORRECTOR]: could not parse tag id '%s', "
+                           "skipped\n" RESET,
+                    tok.c_str());
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+TagPoseCorrector::TagPoseCorrector(std::shared_ptr<ros::NodeHandle> nh,
+                                   std::shared_ptr<VioManager> app,
+                                   const VioManagerOptions &params)
+    : _nh(nh), _app(app), _last_correction(ros::Time(0)) {
+  _trusted_ids = parse_id_list(params.tag_correction_ids);
+  _cam_id = params.tag_correction_cam_id;
+  _stable_count = std::max(1, params.tag_correction_stable_count);
+  _pos_tol_m = params.tag_correction_pos_tol_m;
+  _rot_tol_rad = params.tag_correction_rot_tol_deg * M_PI / 180.0;
+  _cooldown_s = params.tag_correction_cooldown_s;
+
+  if (_trusted_ids.empty()) {
+    PRINT_WARNING(
+        RED "[TAG-CORRECTOR]: tag_correction_enabled is true but "
+            "tag_correction_ids parsed to an empty set -- nothing will ever "
+            "trigger a correction. Check the YAML.\n" RESET);
+  }
+
+  _sub = _nh->subscribe<apriltag_ros::AprilTagDetectionArray>(
+      params.tag_correction_topic, 5, &TagPoseCorrector::callback_tags, this);
+
+  std::string ids_str;
+  for (int id : _trusted_ids) ids_str += std::to_string(id) + " ";
+  PRINT_INFO(GREEN
+             "[TAG-CORRECTOR]: armed on %s, trusted ids = { %s}, cam%d, "
+             "%d consecutive within %.3f m / %.1f deg, %.1f s cooldown\n" RESET,
+             params.tag_correction_topic.c_str(), ids_str.c_str(), _cam_id,
+             _stable_count, _pos_tol_m, params.tag_correction_rot_tol_deg,
+             _cooldown_s);
+}
+
+void TagPoseCorrector::callback_tags(
+    const apriltag_ros::AprilTagDetectionArrayConstPtr &msg) {
+  for (const auto &det : msg->detections) {
+    if (det.id.empty()) continue;
+    const int id = det.id.front();
+    if (_trusted_ids.find(id) == _trusted_ids.end()) continue;
+
+    const auto &p = det.pose.pose.pose.position;
+    const auto &q = det.pose.pose.pose.orientation;
+    Sighting s;
+    s.p_TagInCam = Vec3((DataType)p.x, (DataType)p.y, (DataType)p.z);
+    // apriltag_ros's own convention, Eigen's (x,y,z,w) -- matches this
+    // codebase's rot_2_quat/quat_2_Rot ordering, see quat_ops.h.
+    s.q_CtoTag = Vec4((DataType)q.x, (DataType)q.y, (DataType)q.z,
+                      (DataType)q.w);
+
+    auto &buf = _streak[id];
+
+    // Compare against the streak's FIRST entry rather than the previous one:
+    // pairwise-adjacent agreement lets the estimate drift step by step
+    // within tolerance each time and still "agree" every step, defeating
+    // the point of the gate. Anchoring to the first entry catches that.
+    if (!buf.empty()) {
+      const double dp = (s.p_TagInCam - buf.front().p_TagInCam).norm();
+      const Mat3 R_a = ov_core::quat_2_Rot(buf.front().q_CtoTag);
+      const Mat3 R_b = ov_core::quat_2_Rot(s.q_CtoTag);
+      const Mat3 R_err = R_a.transpose() * R_b;
+      const double cos_half_angle =
+          std::min(1.0, std::max(-1.0, (double)(R_err.trace() - 1.0) / 2.0));
+      const double dtheta = std::acos(cos_half_angle);
+      if (dp > _pos_tol_m || dtheta > _rot_tol_rad) {
+        PRINT_DEBUG(
+            "[TAG-CORRECTOR]: id=%d streak broken (dp=%.4f m, dtheta=%.2f "
+            "deg), restarting\n",
+            id, dp, dtheta * 180.0 / M_PI);
+        buf.clear();
+      }
+    }
+    buf.push_back(s);
+    if ((int)buf.size() < _stable_count) continue;
+
+    if ((ros::Time::now() - _last_correction).toSec() < _cooldown_s) {
+      PRINT_DEBUG("[TAG-CORRECTOR]: id=%d stable but still in cooldown\n",
+                 id);
+      buf.clear();
+      continue;
+    }
+
+    // ---- Stable detection accepted: compute and apply the correction ----
+    // Use the MOST RECENT sighting in the streak, not the first: it is the
+    // freshest measurement of a tag/camera geometry that has not moved.
+    const Sighting &latest = buf.back();
+    buf.clear();
+
+    auto calib_it = _app->get_state()->calib_IMUtoCAM.find(_cam_id);
+    if (calib_it == _app->get_state()->calib_IMUtoCAM.end()) {
+      PRINT_WARNING(RED "[TAG-CORRECTOR]: no calibration for cam%d, "
+                        "cannot apply correction\n" RESET,
+                    _cam_id);
+      continue;
+    }
+    const Mat3 R_ItoC = calib_it->second->Rot();
+    const Vec3 p_IinC = calib_it->second->pos();
+
+    // World := tag frame. See the header comment for the full derivation;
+    // this is its final form, verified independently two different ways
+    // before being written here:
+    //   R_GtoI = R_ItoC^T * R_CtoTag^T
+    //   p_IinG = R_CtoTag^T * (p_IinC - p_TagInCam)
+    const Mat3 R_CtoTag = ov_core::quat_2_Rot(latest.q_CtoTag);
+    const Mat3 R_TagFromCam = R_CtoTag.transpose();
+    const Mat3 R_GtoI = R_ItoC.transpose() * R_TagFromCam;
+    const Vec3 p_IinG = R_TagFromCam * (p_IinC - latest.p_TagInCam);
+    const Vec4 q_GtoI = ov_core::rot_2_quat(R_GtoI);
+
+    if (_app->reset_to_known_pose(q_GtoI, p_IinG)) {
+      _last_correction = ros::Time::now();
+    }
+  }
+}
