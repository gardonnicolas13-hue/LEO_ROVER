+bool VioManager::reset_to_known_pose(const Eigen::Matrix<DataType, 4, 1> &q_GtoI,
+                                     const Eigen::Matrix<DataType, 3, 1> &p_IinG) {
+  // A correction only makes sense once there is a converged state to
+  // correct. Before that, try_to_initialize() is already running and knows
+  // nothing about tags; forcing a pose in here would fight it.
+  if (!is_initialized_vio) {
+    PRINT_WARNING(YELLOW
+                  "[TAG-RESET]: ignored, filter not yet initialized\n" RESET);
+    return false;
+  }
+  // Defensive: a detector artefact (bad Jacobian upstream, NaN corner, ...)
+  // must never be able to silently corrupt the filter with a non-rotation.
+  // Same spirit as this project's llt_guard pattern elsewhere -- check
+  // rather than trust.
+  const DataType q_norm_err = std::abs(q_GtoI.norm() - DataType(1.0));
+  if (!q_GtoI.allFinite() || !p_IinG.allFinite() || q_norm_err > DataType(1e-3)) {
+    PRINT_WARNING(
+        RED "[TAG-RESET]: rejected, invalid pose (|q|=%.6f, finite=%d/%d)\n" RESET,
+        (double)q_GtoI.norm(), q_GtoI.allFinite(), p_IinG.allFinite());
+    return false;
+  }
+
+  PRINT_WARNING(
+      GREEN "[TAG-RESET]: re-anchoring to tag pose -- p_IinG = %.3f,%.3f,%.3f\n" RESET,
+      (double)p_IinG(0), (double)p_IinG(1), (double)p_IinG(2));
+
+  // Deliberately reuses the EXACT primitives already validated by the
+  // divergence-reset above (feed_measurement_imu), not the lighter pattern
+  // in initialize_with_gt: that one only ever runs before any clone/landmark
+  // exists (true cold start for simulation), so overwriting state->imu alone
+  // is safe there. Here, mid-session, existing SLAM clones and landmarks are
+  // tied to the PRE-correction trajectory -- leaving them in place while
+  // jumping the IMU pose would make them geometrically inconsistent with the
+  // new pose. Forcing a full cold re-init (is_initialized_vio = false, both
+  // feature databases purged) is the provably-consistent choice, at the
+  // disclosed cost of a brief re-convergence pause -- see the docstring in
+  // VioManager.h.
+  is_initialized_vio = false;
+  has_moved_since_zupt = false;
+  {
+    Eigen::Matrix<DataType, 16, 1> etat_pose =
+        Eigen::Matrix<DataType, 16, 1>::Zero();
+    etat_pose.block(0, 0, 4, 1) = q_GtoI;
+    etat_pose.block(4, 0, 3, 1) = p_IinG;
+    // velocity, gyro bias, accel bias left at zero: the tag gives a pose, not
+    // a velocity or bias estimate, and zero is the same neutral prior the
+    // divergence-reset above and StaticInitializer's cold start both use.
+    state->imu->set_value(etat_pose);
+    state->imu->set_fej(etat_pose);
+
+    // Same 15-diagonal prior as the divergence reset and StaticInitializer's
+    // cold start (q=0.017, p=0.05, v=0.01, bg=0.02, ba=0.02) -- duplicated
+    // rather than shared for the same reason noted there: keep in sync by
+    // hand if these are ever retuned.
+    VecX prior_diag = VecX::Ones(15);
+    prior_diag.topRows<3>() *= 0.017;   // q
+    prior_diag.segment<3>(3) *= 0.05;   // p
+    prior_diag.segment<3>(6) *= 0.01;   // v
+    prior_diag.segment<3>(9) *= 0.02;   // bg
+    prior_diag.segment<3>(12) *= 0.02;  // ba
+    StateHelper::set_initial_imu_square_root_covariance(state, prior_diag);
+  }
+  trackFEATS->get_feature_database()->cleanup();
+  if (trackARUCO != nullptr) {
+    trackARUCO->get_feature_database()->cleanup();
+  }
+  return true;
+}
