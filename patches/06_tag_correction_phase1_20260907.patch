--- a/ov_srvins/src/ros/TagPoseCorrector.h	1969-12-31 19:00:00.000000000 -0500
+++ b/ov_srvins/src/ros/TagPoseCorrector.h	2026-09-07 16:01:12.478251678 -0400
@@ -0,0 +1,124 @@
+/*
+ * Sqrt-VINS: A Sqrt-filter-based Visual-Inertial Navigation System
+ *
+ * TagPoseCorrector -- Phase 1 AprilTag drift correction (2026-09-07).
+ *
+ * Subscribes to the project-wide /tag_detections (apriltag_ros), and for a
+ * configured allow-list of tag ids, waits for N consecutive detections of
+ * the SAME id that mutually agree within a tolerance, then computes the
+ * IMU's pose in the tag's own frame and calls
+ * VioManager::reset_to_known_pose() to re-anchor the filter.
+ *
+ * DESIGN NOTES
+ *
+ * World = tag frame, by definition, every time. There is no "first sighting
+ * fixes the origin" special case (unlike this project's own
+ * carolus_tf_bridge.py, which DOES latch beacon_link on the first fix): the
+ * physical tag never moves, so re-deriving "IMU pose in the tag's frame"
+ * from scratch on every stable detection gives the identical answer as
+ * latching would, without needing to carry state across sightings. Simpler,
+ * and there is nothing to get out of sync.
+ *
+ * GEOMETRY (verified by two independent derivations before this was
+ * written, and cross-checked against three separate places in this
+ * codebase that all describe the same calib_IMUtoCAM convention:
+ * UpdaterHelper.cpp's R_ItoC/p_IinC, VioManagerOptions.h's own comment
+ * "(q_ItoC, p_IinC)", and Propagator.cpp's R_Gtoi = state->imu->Rot(), which
+ * pins the STATE's own convention to Global-to-IMU, matching
+ * VioManager::initialize_with_gt's documented ordering
+ * [q_GtoI,p_IinG,v_IinG,...]):
+ *
+ *   Given:
+ *     R_ItoC, p_IinC   -- camera-IMU extrinsic (state->calib_IMUtoCAM),
+ *                          "rotate an IMU-frame vector into the camera
+ *                          frame" / "IMU origin, in camera coordinates"
+ *     R_CtoTag, p_TagInCam -- the apriltag_ros detection: R_CtoTag is R^T of
+ *                          the reported quaternion (that quaternion is
+ *                          Tag->Camera, i.e. rotates a TAG-frame vector into
+ *                          the CAMERA frame -- same direction convention as
+ *                          R_ItoC above, both are "rotate FROM the named
+ *                          frame INTO the camera frame"), p_TagInCam is the
+ *                          reported position directly.
+ *
+ *   Then, with World := Tag:
+ *     R_GtoI = R_ItoC^T * R_CtoTag^T             (== (R_CtoTag*R_ItoC)^T)
+ *     p_IinG = R_CtoTag^T * (p_IinC - p_TagInCam)  ... wait, see .cpp: the
+ *              exact expression used there is written directly in terms of
+ *              R_TagFromCam = R_CtoTag^T to avoid re-deriving in code.
+ *
+ * Re-derive by tracking a point at the IMU origin through camera frame then
+ * into the tag frame if this ever needs auditing -- the full derivation is
+ * in the project session notes, not reproduced a third time here.
+ *
+ * WHY A RESET, NOT AN UPDATER: see VioManager::reset_to_known_pose's
+ * docstring. Short version: sqrtVINS/openVINS has no absolute-pose Updater
+ * at all (checked: MSCKF, SLAM, ZeroVelocity are the only three; TrackAruco
+ * treats marker corners as ordinary point features, not a 6-DOF fix). Adding
+ * a real Updater means new Jacobians and a new noise model on an estimator
+ * that has already had several subtle, hard-to-spot bugs found and fixed
+ * this project (ZUPT gating, LLT without .info() checks, a reset that
+ * forgot to also reset covariance). Reusing the already-proven
+ * divergence-reset primitives is deliberately the smaller, lower-risk
+ * change for a Phase 1.
+ *
+ * PHASE 2/3: multiple tags need only a smarter choice of WHICH detection to
+ * trust when several are visible (closest / most stable) -- the geometry
+ * and the reset call are unchanged. SVGS beacons would replace the
+ * subscriber's message type and the geometry above; reset_to_known_pose()
+ * itself is already generic (it takes a pose, not a tag).
+ */
+#ifndef OV_SRVINS_TAGPOSECORRECTOR_H
+#define OV_SRVINS_TAGPOSECORRECTOR_H
+
+#include <apriltag_ros/AprilTagDetectionArray.h>
+#include <ros/ros.h>
+
+#include <deque>
+#include <memory>
+#include <set>
+#include <string>
+
+#include "utils/DataType.h"
+
+namespace ov_srvins {
+
+class VioManager;
+struct VioManagerOptions;
+
+class TagPoseCorrector {
+public:
+  TagPoseCorrector(std::shared_ptr<ros::NodeHandle> nh,
+                   std::shared_ptr<VioManager> app,
+                   const VioManagerOptions &params);
+
+private:
+  void callback_tags(const apriltag_ros::AprilTagDetectionArrayConstPtr &msg);
+
+  /// One accepted detection of a trusted id, kept just long enough to check
+  /// agreement with the next one.
+  struct Sighting {
+    Vec3 p_TagInCam;
+    Vec4 q_CtoTag;  // apriltag_ros's own quaternion, camera->tag, unmodified
+  };
+
+  std::shared_ptr<ros::NodeHandle> _nh;
+  std::shared_ptr<VioManager> _app;
+  ros::Subscriber _sub;
+
+  std::set<int> _trusted_ids;
+  int _cam_id;
+  int _stable_count;
+  double _pos_tol_m;
+  double _rot_tol_rad;
+  double _cooldown_s;
+
+  /// Consecutive-agreement buffer, keyed by tag id so two different trusted
+  /// tags in view at once do not contaminate each other's streak.
+  std::map<int, std::deque<Sighting>> _streak;
+
+  ros::Time _last_correction;
+};
+
+}  // namespace ov_srvins
+
+#endif  // OV_SRVINS_TAGPOSECORRECTOR_H
