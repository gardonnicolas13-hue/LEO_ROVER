   <arg name="path_time" default="/home/lab272/TOUT/logs/sqrtvins_timing.txt"/>
 
+  <!-- Phase 1 AprilTag drift correction (2026-09-07), OFF by default in the
+       YAML. Overridable here, NOT via rosparam set before roslaunch: this
+       node has clear_params equal true, which wipes its whole private
+       namespace as part of THIS launch invocation, so any param set
+       beforehand is gone before the node's own parser ever reads it. This
+       arg/param pair is what survives that wipe, same pattern as verbosity
+       and use_stereo above.
+       Usage: roslaunch ov_srvins sqrtvins_pc.launch tag_correction_enabled:=true
+       or: tools/launch_sqrtvins.sh tag_correction_enabled:=true -->
+  <arg name="tag_correction_enabled" default="false"/>
