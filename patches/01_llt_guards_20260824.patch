+/*
+ * Numerical safety guards for Cholesky (LLT) factorisations.
+ *
+ * WHY THIS FILE EXISTS
+ * --------------------
+ * An audit of this package on 2026-08-24 found NINE Cholesky factorisation
+ * sites, none of which checked `Eigen::LLT::info()`. When an LLT fails --
+ * because the matrix is not positive definite, is rank deficient, or has been
+ * contaminated by a NaN from a single bad measurement -- Eigen does NOT throw.
+ * It returns an UNINITIALISED matrix, and that matrix flows straight into the
+ * next computation. The failure is silent by construction.
+ *
+ * Two distinct consequences, needing two distinct remedies:
+ *
+ *   1. FACTORISATION FEEDING THE STATE (process noise, square-root update).
+ *      A corrupted factor propagates into the covariance at every step. Here
+ *      we want to RECOVER if we reasonably can: a Tikhonov regularisation
+ *      (adding eps*I) makes the matrix strictly positive definite again, and
+ *      on a covariance that means "declare slightly more uncertainty" -- a
+ *      conservative, safe direction. Propagating an uninitialised matrix is
+ *      not safe in any direction.
+ *
+ *   2. FACTORISATION FEEDING A CHI-SQUARED GATE (measurement validation).
+ *      Here recovery is the WRONG instinct. A chi2 computed from a failed
+ *      factorisation is not "small", it is NOT COMPUTABLE -- and because
+ *      NaN compares false against every threshold, an unchecked value slips
+ *      through the gate as if it had passed. The measurement must be
+ *      REJECTED. Regularising to obtain a number would be inventing evidence.
+ *
+ * This distinction is the whole design of this header, and it is why there
+ * are two functions rather than one.
+ *
+ * PRIOR ART IN THIS PROJECT. The upstream bug report filed from this platform
+ * (docs/rpng_sqrtvins_zupt_bug_report.md) fixed exactly one of these sites --
+ * the ZUPT chi2 -- and observed: "the LLT().solve()-without-.info()-check
+ * pattern in particular seems like something worth checking for elsewhere in
+ * the codebase too". This header is the result of doing that check.
+ */
+
+#ifndef OV_CORE_LLT_GUARD_H
+#define OV_CORE_LLT_GUARD_H
+
+#include <algorithm>
+#include <cmath>
+
+#include <Eigen/Dense>
+
+#include "DataType.h"
+#include "colors.h"
+#include "print.h"
+
+namespace ov_core {
+
+/**
+ * @brief Cholesky factorisation with regularisation fallback, for factors that
+ *        feed the state.
+ *
+ * @param A       symmetric matrix to factorise (read only)
+ * @param U_out   upper-triangular factor, written only on success
+ * @param quoi    short label used in the warning, e.g. "process noise"
+ * @return true if a usable factor was produced (directly or after
+ *         regularisation), false if the matrix is beyond repair -- in which
+ *         case the caller MUST skip the operation rather than use U_out.
+ *
+ * The regularisation is scaled to the matrix, not absolute: a fixed epsilon
+ * would be negligible on a large covariance and dominant on a small one.
+ */
+template <typename MatA, typename MatU>
+inline bool llt_guarded(const Eigen::MatrixBase<MatA> &A_in, MatU &U_out,
+                        const char *quoi) {
+  typedef typename MatA::PlainObject MatT;
+  const MatT A = A_in.derived();
+  Eigen::LLT<MatT> chol(A);
+  if (chol.info() == Eigen::Success) {
+    U_out = chol.matrixU();
+    return true;
+  }
+  const DataType echelle =
+      std::max(static_cast<DataType>(1.0),
+               static_cast<DataType>(A.diagonal().maxCoeff()));
+  const DataType eps = static_cast<DataType>(1e-10) * echelle;
+  MatT A_reg = A;
+  A_reg.diagonal().array() += eps;
+  Eigen::LLT<MatT> chol2(A_reg);
+  if (chol2.info() == Eigen::Success) {
+    PRINT_WARNING(YELLOW "[LLT]: %s -- factorisation en echec, regularisee "
+                         "(eps=%.3e)\n" RESET,
+                  quoi, static_cast<double>(eps));
+    U_out = chol2.matrixU();
+    return true;
+  }
+  PRINT_WARNING(RED "[LLT]: %s -- factorisation IRRECUPERABLE meme regularisee "
+                    "(diag min %.3e). Operation ignoree.\n" RESET,
+                quoi, static_cast<double>(A.diagonal().minCoeff()));
+  return false;
+}
+
+/**
+ * @brief Mahalanobis distance with validity check, for chi-squared gates.
+ *
+ * @param S        innovation covariance
+ * @param res      measurement residual
+ * @param chi2_out written only when the result is valid
+ * @return true if chi2 was computed AND is finite AND is non-negative.
+ *
+ * Deliberately NOT regularised: see the header comment. A gate whose input
+ * could not be computed must reject, not guess. The finiteness test is not
+ * decoration -- `nan > threshold` evaluates to false, so an unchecked NaN
+ * passes every gate it meets.
+ */
+template <typename MatS, typename VecR>
+inline bool chi2_guarded(const Eigen::MatrixBase<MatS> &S,
+                         const Eigen::MatrixBase<VecR> &res,
+                         DataType &chi2_out) {
+  typedef typename MatS::PlainObject MatPlain;
+  Eigen::LLT<MatPlain> chol(S.derived());
+  if (chol.info() != Eigen::Success)
+    return false;
+  const DataType c = res.derived().dot(chol.solve(res.derived()));
+  if (!std::isfinite(static_cast<double>(c)) || c < 0)
+    return false;
+  chi2_out = c;
+  return true;
+}
+
+/**
+ * @brief Linear solve through a Cholesky factorisation, with validity check.
+ *
+ * @param A     symmetric positive-definite system matrix
+ * @param b     right-hand side
+ * @param x_out solution, written only when valid
+ * @return true if the factorisation succeeded AND the solution is finite.
+ *
+ * For solves whose result feeds the STATE (a correction increment, an LM
+ * step). Unlike llt_guarded() there is no regularisation fallback here: a
+ * regularised solve silently returns the answer to a DIFFERENT problem than
+ * the one asked, which for a state increment means applying a correction that
+ * was never computed. Returning false lets the caller skip the step, which is
+ * always a valid choice for an increment -- not applying a correction leaves
+ * the state where it was, applying a wrong one does not.
+ */
+// Trois parametres de gabarit distincts, et non un seul pour « le vecteur » :
+// les appelants passent indifferemment un VecX, un Vec3, ou une Eigen::Ref
+// sur une colonne d'une plus grande matrice. Forcer un type unique faisait
+// echouer la deduction sans rien apporter en securite.
+template <typename MatA, typename VecB, typename VecX_>
+inline bool llt_solve_guarded(const Eigen::MatrixBase<MatA> &A,
+                              const Eigen::MatrixBase<VecB> &b, VecX_ &x_out) {
+  typedef typename MatA::PlainObject MatPlain;
+  Eigen::LLT<MatPlain> chol(A.derived());
+  if (chol.info() != Eigen::Success)
+    return false;
+  const typename VecB::PlainObject x = chol.solve(b.derived());
+  if (!x.allFinite())
+    return false;
+  x_out = x;
+  return true;
+}
+
+} // namespace ov_core
+
+#endif // OV_CORE_LLT_GUARD_H
